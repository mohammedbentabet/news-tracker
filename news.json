name: Update News Data

on:
  schedule:
    # Runs every 15 minutes. GitHub enforces a 5-minute minimum and may delay
    # runs at peak load, so treat this as "roughly every 15-30 minutes".
    - cron: '*/15 * * * *'
  workflow_dispatch: {}   # lets you trigger a run manually from the Actions tab

permissions:
  contents: write

jobs:
  fetch:
    runs-on: ubuntu-latest
    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: Install dependencies
        run: pip install -r requirements.txt

      - name: Fetch news
        run: python scripts/fetch_news.py

      - name: Commit updated data
        run: |
          git config user.name "news-bot"
          git config user.email "news-bot@users.noreply.github.com"
          git add data/news.json
          git diff --quiet --cached || git commit -m "Update news data $(date -u +'%Y-%m-%d %H:%M UTC')"
          git push
